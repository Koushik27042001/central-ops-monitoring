# Local development configuration.
NODE_ENV=development
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/centralops_demo
LOG_LEVEL=info
# Generate the same private 32-byte hex key for the API and worker.
# INTEGRATION_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
# ADMIN_PASSWORD=choose-a-unique-password-of-at-least-14-characters

# Monitoring and publishing jobs use MongoDB. No Redis configuration is needed.
