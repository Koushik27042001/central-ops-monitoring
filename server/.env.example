# Local development configuration.
NODE_ENV=development
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/centralops_demo
LOG_LEVEL=info
# Generate the same private 32-byte hex key for the API and worker.
# INTEGRATION_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
# ADMIN_PASSWORD=choose-a-unique-password-of-at-least-14-characters

# Reference only: add your backend public outbound IP /32 to Atlas Network Access.
# This variable does not change the machine IP or configure the Atlas allowlist.
# MONGODB_ATLAS_ALLOWED_IP=



# Render supplies PORT automatically; API_PORT is the local fallback.
# PORT=10000
# Set to 1 on Render, 0 when running locally without a reverse proxy.
TRUST_PROXY_HOPS=0
# Production CLIENT_ORIGIN must be your exact Vercel HTTPS origin (no trailing slash).

# Monitoring and publishing jobs use MongoDB. No Redis configuration is needed.

# Firebase Admin credentials: server only.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste service account private_key in double quotes with literal backslash-n escapes.
FIREBASE_PRIVATE_KEY=
# Used only when PUBLIC_REGISTRATION=false; not required for public signup.
FIREBASE_ADMIN_EMAILS=

# Allow verified freelancers to create their own private workspace.
PUBLIC_REGISTRATION=true

# Per-workspace admission limits for public hosting.
WORKSPACE_MAX_WEBSITES=25
WORKSPACE_MAX_ENDPOINTS=100
WORKSPACE_MAX_RECORDS=1000
WORKSPACE_MAX_PENDING_JOBS=25

# Fixed login session duration (days), not a sliding expiry.
AUTH_SESSION_DAYS=2

# Readable terminal output; use json for structured hosting logs.
LOG_FORMAT=text
# Enable only when investigating individual website requests.
LOG_HTTP_REQUESTS=false
